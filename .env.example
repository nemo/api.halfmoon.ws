# --- inky-mirror v2 (see inky/README.md) ---
# Model
ANTHROPIC_API_KEY=
# INKY_MODEL=claude-sonnet-5-5
# INKY_AMBIENT_MODEL=1            # 0 = use the built-in ambient generators instead of the model

# Data
OPENWEATHERMAP_APIKEY=
ICAL_URLS=work|https://calendar.google.com/calendar/ical/.../basic.ics,personal|https://calendar.google.com/calendar/ical/.../basic.ics
ICAL_OWNER_EMAILS=                # optional: your addresses, comma-separated (better declined/OOO filtering)
GOOGLE_MAPS_API_KEY=              # optional: Routes API, for travel time
HOME_ADDRESS=                     # never commit; used as the travel origin
HOME_LAT=
HOME_LNG=
HOME_PLACE=Fort Greene            # shown in the dateline
# PLANTS_FIRST_DUE=2026-11-08     # optional: first watering day before the first button press

# Auth
INKY_DEVICE_TOKEN=                # the Pi: frame, buttons, preview
INKY_NOTES_TOKEN=                 # you and your agents: POST /inky/notes

# State (set automatically by Vercel's Upstash Redis integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Tuning
# INKY_TZ=America/New_York
# INKY_REFRESH_MINUTES=30
# INKY_THEME=green                # mono | green | inverse
# CHROMIUM_PACK_URL=              # optional: remote @sparticuz/chromium pack if the bundled binary is too large

# --- legacy endpoints ---
OPEN_AI_ACCESS_TOKEN=
FOURSQUARE_CLIENT_ID=
FOURSQUARE_CLIENT_SECRET=
FOURSQUARE_ACCESS_TOKEN=
